{
  "name": "env-vault",
  "description": "Encrypted .env file manager. Seal secrets into committable vault files (AEAD + Argon2id).",
  "version": "1.0.0",
  "author": {
    "name": "anivaryam",
    "url": "https://github.com/anivaryam"
  },
  "homepage": "https://github.com/anivaryam/env-vault",
  "license": "MIT",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/detect-config.sh\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
